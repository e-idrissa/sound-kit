generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @unique
  email     String   @unique
  password  String
  firstname String
  lastname  String
  role      String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  passwordResetTokens PasswordResetToken[]
  instruments         Instrument[]
  rentals             Rental[]
  requests            Request[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model QRCode {
  id        String   @id @unique
  imageUrl  String 
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  instrument Instrument[]
}

model Category {
  id        String   @id @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  instruments        Instrument[]
  BorrowedInstrument BorrowedInstrument[]
}

model Brand {
  id        String   @id @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  instruments        Instrument[]
  BorrowedInstrument BorrowedInstrument[]
}

model Warehouse {
  id        String   @id @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  instruments        Instrument[]
  BorrowedInstrument BorrowedInstrument[]
}

model Rental {
  id        String   @id @unique
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  instruments Instrument[]

  userId String
  user   User   @relation(fields: [userId], references: [id])

  reasonId String
  reason   RentalReason @relation(fields: [reasonId], references: [id])
}

model RentalReason {
  id        String   @id @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  rentals Rental[]
}

model Instrument {
  id         String  @id @unique
  state      String
  isAffected Boolean
  situation  String
  inUse      Boolean

  qrCodeId String @unique
  qrCode   QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])

  rentalId String?
  rental   Rental? @relation(fields: [rentalId], references: [id])

  requests Request[]
}

model Request {
  id        String   @id @unique
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  instrumentId String?
  instrument   Instrument? @relation(fields: [instrumentId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  reasonId String
  reason   RequestReason @relation(fields: [reasonId], references: [id])
}

model RequestReason {
  id        String   @id @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  requests Request[]
}

model BorrowedInstrument {
  id        String   @id @unique
  state     String
  inUse     Boolean
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id])
}

model Loan {
  id        String   @id @unique
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  instruments BorrowedInstrument[]
}
